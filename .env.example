# INSTRUÇÕES DO SUPABASE
# Para conectar a um projeto ativo do Supabase:
# 1. Crie um projeto em https://supabase.com
# 2. Execute o arquivo sql `supabase/schema.sql` no SQL Editor do Supabase.
# 3. Copie as chaves abaixo e cole no arquivo `.env`

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
